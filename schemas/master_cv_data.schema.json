{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warnes-innovations.github.io/cv-builder/schemas/master_cv_data.schema.json",
  "title": "Master_CV_Data",
  "description": "Compatibility-oriented schema for Master_CV_Data.json used by cv-builder.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "personal_info": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "citizenship": {
          "type": "string",
          "description": "Optional citizenship / clearance-eligibility statement for applicants targeting federal-contract roles, where screening for citizenship or clearance eligibility typically precedes substantive review. Deliberately free text rather than structured fields: the required phrasing varies by agency, and how much eligibility an applicant is willing to assert is their own decision. RENDERED CONDITIONALLY: on by default only for summary variants aimed at federal roles (CVOrchestrator.CITIZENSHIP_DEFAULT_VARIANTS), otherwise only when the session sets include_citizenship; an explicit include_citizenship wins in both directions. Default is silence because the ATS DOCX is machine-parsed into third-party tracking systems. See MASTER_CV_DATA_SPECIFICATION.md section 4.1."
        },
        "contact": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "email": { "type": "string" },
            "phone": { "type": "string" },
            "linkedin": { "type": "string" },
            "website": { "type": "string" },
            "address": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "street": { "type": "string" },
                "city": { "type": "string" },
                "state": { "type": "string" },
                "zip": { "type": "string" },
                "display": { "type": "string" }
              }
            }
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "language": { "type": "string" },
                  "name": { "type": "string" },
                  "proficiency": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "professional_summaries": {
      "description": "Primary form is object; legacy list form is also accepted.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "experience": {
      "type": "array",
      "items": { "$ref": "#/$defs/experienceEntry" }
    },
    "experiences": {
      "description": "Legacy alias accepted by some routes.",
      "type": "array",
      "items": { "$ref": "#/$defs/experienceEntry" }
    },
    "selected_achievements": {
      "type": "array",
      "items": { "$ref": "#/$defs/selectedAchievement" }
    },
    "skills": {
      "description": "Supports legacy flat lists and categorized dictionary forms.",
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/skillItem" }
        },
        {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "array",
                "items": { "$ref": "#/$defs/skillItem" }
              },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "category": { "type": "string" },
                  "skills": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/skillItem" }
                  }
                },
                "required": ["skills"]
              }
            ]
          }
        }
      ]
    },
    "education": {
      "type": "array",
      "items": { "$ref": "#/$defs/educationEntry" }
    },
    "awards": {
      "type": "array",
      "items": { "$ref": "#/$defs/awardEntry" }
    },
    "certifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/certificationEntry" }
    },
    "publications_file": { "type": "string" },
    "patents_file": { "type": "string" }
  },
  "$defs": {
    "stringOrStringArray": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "skillItem": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string" },
            "category": { "type": "string" },
            "years": { "type": ["integer", "number"] },
            "skill_type": {
              "type": "string",
              "enum": ["hard", "soft"],
              "description": "Optional explicit classification. Omit to use heuristic inference."
            },
            "aliases": {
              "type": "array",
              "items": { "type": "string" }
            },
            "relevant_for": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    "achievementInExperience": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "id": { "type": "string" },
            "text": { "type": "string" },
            "keywords": {
              "type": "array",
              "items": { "type": "string" }
            },
            "metrics": {
              "type": "array",
              "items": { "type": "string" }
            },
            "tags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "importance": { "type": ["integer", "number"] },
            "relevant_for": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    "experienceEntry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "comment": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "division": {
          "type": ["string", "null"],
          "description": "Optional. The major organisational unit the role sat in (e.g. \"Global Research and Development\"). Absent or null means unknown."
        },
        "department": {
          "type": ["string", "null"],
          "description": "Optional. The sub-unit, group or team inside the division (e.g. \"Non-Clinical Statistics\"). Absent or null means unknown."
        },
        "location": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "city": { "type": "string" },
                "state": { "type": "string" }
              }
            }
          ]
        },
        "start_date": { "type": ["string", "null"] },
        "end_date": { "type": ["string", "null"] },
        "employment_type": {
          "type": "string",
          "description": "Kind of engagement. The authoritative vocabulary is EMPLOYMENT_TYPES in scripts/routes/master_data_routes.py, served to the editor's dropdown by GET /api/master-data/vocabularies. Deliberately NOT an enum here: this file is the source of truth, so a value it already holds must never fail validation — that is the direction of failure this field's history is made of. The API route is the narrower gate and is where a new value gets rejected.",
          "examples": [
            "full_time",
            "part_time",
            "contract",
            "consulting",
            "internship",
            "self_employed",
            "joint_appointment",
            "volunteer",
            "founding_contributor",
            "equity_only"
          ]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "audience": {
          "type": "array",
          "items": { "type": "string" }
        },
        "domain_relevance": {
          "type": "array",
          "items": { "type": "string" }
        },
        "importance": { "type": ["integer", "number"] },
        "achievements": {
          "type": "array",
          "items": { "$ref": "#/$defs/achievementInExperience" }
        },
        "bullets": {
          "type": "array",
          "items": { "$ref": "#/$defs/achievementInExperience" }
        }
      }
    },
    "selectedAchievement": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metrics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "importance": { "type": ["integer", "number"] },
        "relevant_for": {
          "type": "array",
          "items": { "type": "string" }
        },
        "show_for_roles": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "educationEntry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "degree": { "type": "string" },
        "field": { "type": "string" },
        "institution": { "type": "string" },
        "location": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "city": { "type": "string" },
                "state": { "type": "string" }
              }
            }
          ]
        },
        "start_year": { "type": ["integer", "number"] },
        "end_year": { "type": ["integer", "number"] },
        "relevant_for": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "awardEntry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "year": { "type": ["integer", "number"] },
        "description": { "type": "string" },
        "relevant_for": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "certificationEntry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name":   { "type": "string" },
        "issuer": { "type": "string" },
        "year":   { "type": ["integer", "number"] }
      }
    }
  }
}
